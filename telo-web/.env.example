# Telo — environment template. Copy to telo-web/.env (gitignored). Never commit secrets.

# --- Noble SQL Server (Telo's own pool; same server/login as Listec) ---------
TELO_SQL_SERVER=122.161.198.159,1433
TELO_SQL_DATABASE=Noble
TELO_SQL_USER=nobleone
TELO_SQL_PASSWORD=replace-me
TELO_SQL_ENCRYPT=true
TELO_SQL_TRUST_CERT=true
TELO_SQL_APP_NAME=TeloApp
TELO_SQL_CONNECT_TIMEOUT_MS=15000
TELO_SQL_REQUEST_TIMEOUT_MS=120000

# --- Read-path proxy to the existing Listec container -----------------------
LISTEC_API_BASE_URL=http://listec:31311

# --- Sessions / cache -------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Auth.js ----------------------------------------------------------------
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-32+char-random-secret
NEXTAUTH_URL=http://localhost:3000

# Public base URL printed into the report QR (patient softcopy link, /r/<sid>).
# Must be the externally reachable origin, e.g. https://telo.genomicslab.in.
# Falls back to NEXTAUTH_URL if unset.
REPORT_PUBLIC_BASE_URL=
# Optional dedicated secret for report tokens; falls back to NEXTAUTH_SECRET.
REPORT_TOKEN_SECRET=

# --- CCAvenue (online client payments) --------------------------------------
# Merchant credentials for the URL registered against telo.genomicslab.in in the
# CCAvenue dashboard (Settings → API Keys). SECRETS — never commit real values.
# If any of the three are blank the Pay Now button is hidden (feature off).
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_WORKING_KEY=
# Gateway endpoint — leave as-is for production; use the test.ccavenue.com URL
# while integrating against the CCAvenue test environment.
CCAVENUE_REQUEST_URL=https://secure.ccavenue.com/transaction/transaction.do?command=initiateTransaction
# Externally-reachable origin CCAvenue knows (MUST match the registered URL).
# The redirect/cancel callbacks are derived as <base>/api/ccavenue/callback.
# Falls back to REPORT_PUBLIC_BASE_URL, then NEXTAUTH_URL, if unset.
CCAVENUE_BASE_URL=https://telo.genomicslab.in
# Optional explicit overrides (otherwise derived from CCAVENUE_BASE_URL):
CCAVENUE_REDIRECT_URL=
CCAVENUE_CANCEL_URL=
CCAVENUE_CURRENCY=INR

# --- Razorpay (Phase 5) -----------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
