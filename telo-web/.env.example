# Telo — environment template. Copy to telo-web/.env (gitignored). Never commit secrets.

# --- Noble SQL Server (Telo's own pool; same server/login as Listec) ---------
TELO_SQL_SERVER=122.161.198.159,1433
TELO_SQL_DATABASE=Noble
TELO_SQL_USER=nobleone
TELO_SQL_PASSWORD=replace-me
TELO_SQL_ENCRYPT=true
TELO_SQL_TRUST_CERT=true
TELO_SQL_APP_NAME=TeloApp
TELO_SQL_CONNECT_TIMEOUT_MS=15000
TELO_SQL_REQUEST_TIMEOUT_MS=120000

# --- Read-path proxy to the existing Listec container -----------------------
LISTEC_API_BASE_URL=http://listec:31311

# --- Sessions / cache -------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Auth.js ----------------------------------------------------------------
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-32+char-random-secret
NEXTAUTH_URL=http://localhost:3000

# --- Razorpay (Phase 5) -----------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
